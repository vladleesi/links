{
  "name": "link-site",
  "version": "1.4.8",
  "description": "A minimal, reusable YAML-driven personal link hub built with Astro.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "test:version": "node scripts/test-version.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test:browser": "node scripts/test-browser.mjs",
    "test:config": "node scripts/test-config.mjs",
    "test:themes": "node scripts/test-themes.mjs",
    "test:og": "node scripts/test-og.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
