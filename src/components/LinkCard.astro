---
import Icon from './Icon.astro';
import type { ResolvedLink } from '../lib/links';
interface Props { link: ResolvedLink; }
const { link } = Astro.props;
---
<a class="link-card" href={link.url} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
  <Icon name={link.icon} />
  <span class="link-copy"><span class="link-name">{link.name}</span>{link.hostname && <span class="hostname">{link.hostname}</span>}</span>
  {link.external && <><Icon name="external" class="external-icon" /><span class="sr-only"> (opens in a new tab)</span></>}
</a>