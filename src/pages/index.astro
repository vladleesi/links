---
import '../styles/global.css';
import { config, displayName, title, description, assetPath } from '../lib/config';
import { theme, themeCss } from '../lib/theme';
import { resolveLinks } from '../lib/links';
import LinkCard from '../components/LinkCard.astro';
import DebugThemePicker from '../components/DebugThemePicker.astro';

const debug = import.meta.env.DEV || import.meta.env.MODE === 'debug';

const links = resolveLinks(config.links);
const image = new URL('og.png', config.site.url).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: displayName, alternateName: config.profile.username, url: config.site.url,
  sameAs: links.filter(link => link.profile).map(link => link.url),
};
const year = process.env.SOURCE_DATE_EPOCH ? new Date(Number(process.env.SOURCE_DATE_EPOCH) * 1000).getUTCFullYear() : new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en" data-mode={config.site.mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={config.site.url} />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <meta name="theme-color" content={theme.light.background} media={config.site.mode ? (config.site.mode === 'light' ? undefined : 'not all') : '(prefers-color-scheme: light)'} />
    <meta name="theme-color" content={theme.dark.background} media={config.site.mode ? (config.site.mode === 'dark' ? undefined : 'not all') : '(prefers-color-scheme: dark)'} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={config.site.url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline>
      try {
        const mode = localStorage.getItem('link-site-mode');
        if (mode === 'light' || mode === 'dark') document.documentElement.dataset.mode = mode;
      } catch { /* Keep the configured or system appearance when storage is unavailable. */ }
    </script>
    <style is:inline set:html={themeCss} />
  </head>
  <body>
    <a class="skip-link" href="#links">Skip to links</a>
    <main class="page">
      <header class="profile">
        <div class="profile-copy">
          <h1>{config.profile.fullName || '@' + config.profile.username}</h1>
          {config.profile.fullName && <p class="username">@{config.profile.username}</p>}
          {config.profile.title && <p class="profile-title">{config.profile.title}</p>}
        </div>
        <button class="mode-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" hidden>
          <svg class="mode-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" /></svg>
          <svg class="mode-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
        </button>
      </header>
      <nav id="links" aria-label="Personal links" tabindex="-1"><ul class="links">{links.map(link => <li><LinkCard link={link} /></li>)}</ul></nav>
      <footer>© {year} {config.profile.username} <a class="credits-link" href={assetPath('credits.txt')}>Credits</a> {debug && <DebugThemePicker />}</footer>
    </main>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.mode-toggle');
      const root = document.documentElement;
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      const colors = Array.from(document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]'), meta => meta.content);
      const isDark = () => root.dataset.mode ? root.dataset.mode === 'dark' : system.matches;

      function syncMode() {
        const dark = isDark();
        toggle?.setAttribute('aria-checked', String(dark));
        if (toggle) toggle.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
        document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach(meta => {
          meta.content = colors[dark ? 1 : 0];
          meta.removeAttribute('media');
        });
      }

      if (toggle) {
        syncMode();
        toggle.addEventListener('click', () => {
          root.dataset.mode = isDark() ? 'light' : 'dark';
          try { localStorage.setItem('link-site-mode', root.dataset.mode); } catch { /* Switching still works without storage. */ }
          syncMode();
        });
        system.addEventListener('change', syncMode);
        toggle.hidden = false;
      }
    </script>
  </body>
</html>
